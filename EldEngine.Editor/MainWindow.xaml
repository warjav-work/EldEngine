<Window x:Class="EldEngine.Editor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EldEngine.Editor"
        mc:Ignorable="d"
        Title="Eld Game Engine Editor" Height="700" Width="1400"
        Background="#1E1E1E" 
        Foreground="White"
        WindowState="Maximized">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <StackPanel Grid.Row="0" 
                    Grid.ColumnSpan="3" 
                    Orientation="Horizontal" 
                    Background="#2D2D2D"                    
                    VerticalAlignment="Center">
            <Button Content="📄 New Scene" 
                    Padding="10,5" 
                    Margin="5"
                    Background="#0E639C"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="📂 Load Scene" 
                    Click="OnLoadSceneClick" 
                    Padding="10,5" 
                    Margin="5"
                    Background="#0E639C"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="💾 Save Scene" 
                    Click="OnSaveSceneClick" 
                    Padding="10,5" Margin="5"
                    Background="#107C10"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Separator Background="#444" Margin="10,0" Width="2"/>
            <Button Content="➕ Create Entity" 
                    Click="OnCreateEntityClick" 
                    Padding="10,5" 
                    Margin="5" 
                    Background="#107C10"
                    Foreground="White"
                    FontWeight="Bold"/>
            <Button Content="🗑️ Delete Entity" 
                    Click="OnDeleteEntityClick" 
                    Padding="10,5" Margin="5"
                    Background="#D13438"
                    Foreground="White"
                    FontWeight="Bold"/>
        </StackPanel>

        <!-- Hierarchy Panel -->
        <Border Grid.Row="1" 
                Grid.Column="0" 
                Background="#252526" 
                BorderBrush="#3E3E42" 
                BorderThickness="0,0,1,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="🌳 Hierarchy" 
                           Foreground="White" 
                           Padding="10,5" 
                           FontWeight="Bold"
                           Background="#2D2D2D"/>

                <ListBox x:Name="EntityListView" 
                         Background="#1E1E1E" 
                         Foreground="White" 
                         BorderThickness="0"
                         SelectionChanged="OnEntityListSelectionChanged"
                         DockPanel.Dock="Bottom">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" 
                                          Foreground="White"
                                          FontWeight="Bold"/>
                                <TextBlock Text="{Binding Entity.Id, StringFormat='ID: {0}'}" 
                                          Foreground="#999"
                                          FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Viewport -->
        <Border Grid.Row="1" 
                Grid.Column="1" 
                Background="#1E1E1E" 
                BorderBrush="#3E3E42" 
                BorderThickness="1">
            <Grid>
                <TextBlock Text="🎮 Scene Viewport (Preview)" 
                          VerticalAlignment="Center" 
                          HorizontalAlignment="Center" 
                          Foreground="#666"
                          FontSize="18"/>
            </Grid>
        </Border>

        <!-- Properties Panel -->
        <Border Grid.Row="1" 
                Grid.Column="2" 
                Background="#252526" 
                BorderBrush="#3E3E42" 
                BorderThickness="1,0,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Text="⚙️ Properties" 
                           Foreground="White" 
                           Padding="10,5" 
                           FontWeight="Bold"
                           Background="#2D2D2D"/>

                <ScrollViewer DockPanel.Dock="Bottom" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PropertiesPanel" 
                                Background="#252526">
                        <TextBlock Text="Select an entity to view properties" 
                                  Foreground="#999" 
                                  Padding="10"
                                  FontStyle="Italic"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== DEBUG PANEL (HIDDEN) ==================== -->
        <TextBlock x:Name="DebugInfo"
                   Visibility="Collapsed"
                   Text="Debug Info"
                   Foreground="White"
                   Padding="10"/>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2" 
                   Grid.ColumnSpan="3" 
                   Background="#2D2D2D" 
                   Foreground="White">
            <TextBlock x:Name="StatusBar" 
                       Text="Ready"
                       Padding="5,0"/>
        </StatusBar>
    </Grid>
</Window>
